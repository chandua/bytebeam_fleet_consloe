# Uncomment this line to define a global platform for your project
# platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require 'json'
require 'fileutils'

flutter_ios_podfile_setup

# Prefetch duckdb.xcframework (device + simulator). Upstream .framework is
# device-only and fails: "Building for iOS-simulator, but linking in dylib… iOS".
def ensure_duckdb_ios_xcframework!
  plugins_path = File.expand_path(File.join('..', '.flutter-plugins-dependencies'), __FILE__)
  return unless File.exist?(plugins_path)

  plugins = JSON.parse(File.read(plugins_path))
  duckdb = (plugins.dig('plugins', 'ios') || []).find { |p| p['name'] == 'dart_duckdb' }
  return if duckdb.nil?

  ios_dir = File.join(duckdb['path'], 'ios')
  release_dir = File.join(ios_dir, 'Libraries', 'release')
  xcframework_dir = File.join(release_dir, 'duckdb.xcframework')
  puts "dart_duckdb iOS plugin path: #{ios_dir}"

  # Drop stale device-only framework so CocoaPods cannot link it for simulator.
  stale = File.join(release_dir, 'duckdb.framework')
  FileUtils.rm_rf(stale) if File.exist?(stale)

  return if File.directory?(xcframework_dir)

  FileUtils.mkdir_p(release_dir)
  url = 'https://github.com/yharby/duckdb-dart/releases/download/v1.4.3-ios/duckdb-xcframework-ios.zip'
  zip_path = File.join(ios_dir, 'duckdb-xcframework-ios.zip')
  puts "Prefetching DuckDB iOS XCFramework from #{url}"
  system('curl', '-fL', '-o', zip_path, url) or raise 'Failed to download duckdb-xcframework-ios.zip'
  system('unzip', '-o', zip_path, '-d', release_dir) or raise 'Failed to unzip duckdb-xcframework-ios.zip'
  FileUtils.rm_f(zip_path)

  unless File.directory?(xcframework_dir)
    found = Dir.glob(File.join(release_dir, '**/duckdb.xcframework')).first
    FileUtils.mv(found, xcframework_dir) if found && found != xcframework_dir
  end
  raise 'duckdb.xcframework missing after unzip' unless File.directory?(xcframework_dir)
end

ensure_duckdb_ios_xcframework!

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end
end
